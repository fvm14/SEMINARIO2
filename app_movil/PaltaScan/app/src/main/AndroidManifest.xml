<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PaltaScanApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_palta"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaltaScan">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.ResultadoActivity"
            android:label="@string/titulo_resultado"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.HistorialActivity"
            android:label="@string/titulo_historial"
            android:parentActivityName=".ui.MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>
</manifest>
