<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PaltaScanApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_palta"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaltaScan">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.GuiaActivity" />
        <activity
            android:name=".ui.MainActivity"
            android:launchMode="singleTop" />
        <activity android:name=".ui.VistaPreviaActivity" />
        <activity android:name=".ui.AnalisisActivity" />
        <activity android:name=".ui.ErrorAnalisisActivity" />
        <activity android:name=".ui.ResultadoActivity" />
        <activity android:name=".ui.NuevoLoteActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LoteActivity" />
        <activity android:name=".ui.ComoFuncionaActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>
</manifest>
