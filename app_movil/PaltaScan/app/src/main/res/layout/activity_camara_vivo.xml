<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/vistaCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- Contornos de las paltas y defectos del ultimo cuadro (misma escala que la camara) -->
    <ImageView
        android:id="@+id/capaContornos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <!-- Resultado del ultimo cuadro analizado -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/fondo_panel_vivo"
        android:orientation="vertical"
        android:padding="2dp">

        <TextView
            android:id="@+id/textoCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#424242"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/vivo_esperando"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/textoDefecto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoMadurez"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoConfianza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textoAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textoFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#9E9E9E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicacion y modelo en uso -->
    <TextView
        android:id="@+id/textoIndicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</FrameLayout>
