<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio: logo y nombre mientras se carga el modelo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario_claro"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_palta" />

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/app_name"
        android:textColor="@color/cat_i"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/inicio_lema"
        android:textColor="@color/texto_suave"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="40dp"
        android:indeterminateTint="@color/cat_i" />

    <TextView
        android:id="@+id/textoCarga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/preparando_modelo"
        android:textColor="@color/cat_i"
        android:textSize="14sp" />
</LinearLayout>
