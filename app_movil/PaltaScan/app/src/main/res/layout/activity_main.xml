<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario_oscuro"
    android:orientation="vertical">

    <!-- Barra: nombre, estado y ayuda -->
    <LinearLayout
        style="@style/Barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/fondo_circulo"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_palta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TituloBarra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/textoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/botonAyuda"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/info_titulo"
            android:src="@drawable/ic_info"
            app:tint="#FFFFFF" />
    </LinearLayout>

<ScrollView
    android:id="@+id/desplazamiento"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Lote, modelo y procesador -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPaddingBottom="6dp"
            app:contentPaddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Lote actual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lote" />

                    <TextView
                        android:id="@+id/textoLote"
                        style="@style/Valor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/botonLote"
                        style="@style/BotonTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cambiar_lote" />
                </LinearLayout>

                <!-- Modelo (solo si hay mas de uno instalado) -->
                <LinearLayout
                    android:id="@+id/filaModelo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modelo" />

                    <TextView
                        android:id="@+id/textoModeloActual"
                        style="@style/Valor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/botonModelo"
                        style="@style/BotonTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cambiar_lote" />
                </LinearLayout>

                <!-- Procesador (solo version completa y si el telefono admite la GPU) -->
                <LinearLayout
                    android:id="@+id/filaProcesador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/procesador" />

                    <TextView
                        android:id="@+id/textoProcesador"
                        style="@style/Valor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/botonProcesador"
                        style="@style/BotonTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cambiar_lote" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Captura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCamara"
                style="@style/Boton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/tomar_foto"
                app:icon="@drawable/ic_camara" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGaleria"
                style="@style/BotonBorde"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/galeria"
                app:icon="@drawable/ic_galeria" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonVivo"
            style="@style/BotonBorde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/camara_vivo"
            app:icon="@drawable/ic_encuadre" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonHistorial"
            style="@style/BotonBorde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_historial"
            app:icon="@drawable/ic_historial" />

        <!-- Progreso -->
        <LinearLayout
            android:id="@+id/panelProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                style="@style/Valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/analizando" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoMensaje"
            style="@style/Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/sin_resultado" />

        <!-- Resultado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaResultado"
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <include
                android:id="@+id/resultado"
                layout="@layout/vista_resultado" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
</LinearLayout>
