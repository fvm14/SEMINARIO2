<?xml version="1.0" encoding="utf-8"?>
<!-- Primera fila de la lista del lote: datos, resumen y titulo de la lista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textoOrigen"
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/textoTotal"
        style="@style/Subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <include
        android:id="@+id/resumen"
        layout="@layout/vista_resumen" />

    <TextView
        android:id="@+id/textoNotas"
        style="@style/Etiqueta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textoTituloLista"
        style="@style/Subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textoLoteVacio"
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lote_vacio"
        android:visibility="gone" />
</LinearLayout>
