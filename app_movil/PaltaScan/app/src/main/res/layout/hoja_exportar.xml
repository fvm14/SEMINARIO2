<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/exportar_lote" />

    <TextView
        android:id="@+id/textoLote"
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/opcionPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/fondo_ilustracion"
            android:backgroundTint="@color/rechazo_fondo"
            android:gravity="center"
            android:text="@string/exportar_pdf"
            android:textColor="@color/rechazo"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Cuerpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exportar_pdf"
                android:textStyle="bold" />

            <TextView
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exportar_pdf_texto" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/opcionCsv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/fondo_ilustracion"
            android:gravity="center"
            android:text="@string/exportar_csv"
            android:textColor="@color/verde_palta"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Cuerpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exportar_csv"
                android:textStyle="bold" />

            <TextView
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exportar_csv_texto" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
