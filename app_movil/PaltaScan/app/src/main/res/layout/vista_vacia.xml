<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vacio reutilizable (historial y lotes). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="40dp">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/fondo_ilustracion">

        <ImageView
            android:id="@+id/iconoVacio"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/verde_palta" />
    </FrameLayout>

    <TextView
        android:id="@+id/tituloVacio"
        style="@style/Subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="14sp" />

    <Button
        android:id="@+id/botonVacio"
        style="@style/BotonPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="28dp" />
</LinearLayout>
