    <!-- Como funciona -->
    <string name="cf_titulo">Una foto, tres resultados</string>
    <string name="cf_intro">El modelo encuentra la palta, marca los defectos de la cáscara y estima su madurez. Todo ocurre en tu celular.</string>
    <string name="cf_calidad">1 · CALIDAD (NORMA OCDE)</string>
    <string name="cf_calidad_texto">La categoría depende del área de la cáscara con defectos. Los límites de 4 cm² y 6 cm² equivalen a 9,4 % y 14,1 % del área de una palta promedio.</string>
    <string name="cf_cat_i">Hasta 4 cm²\n≤ 9,4 %</string>
    <string name="cf_cat_ii">Hasta 6 cm²\n9,4 – 14,1 %</string>
    <string name="cf_rechazo">Más de 6 cm²\n&gt; 14,1 %</string>
    <string name="cf_madurez">2 · MADUREZ</string>
    <string name="cf_madurez_texto">Se estima por el color de la cáscara, de verde claro a casi negro. La confianza indica qué tan seguro está el modelo.</string>
    <string name="cf_limite">La app no mide calibre ni peso. Solo evalúa defectos visibles y madurez.</string>
