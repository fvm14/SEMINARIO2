<resources>
    <!-- Paleta sobria: verdes y ocres apagados, sin fondos de color fuertes. -->
    <color name="primario">#55704F</color>
    <color name="fondo">#FAFAF8</color>
    <color name="texto">#2B2B2B</color>
    <color name="texto_suave">#6B6B6B</color>
    <color name="linea">#DDDDD8</color>
    <color name="cat_i">#4E7A4E</color>
    <color name="cat_ii">#9A7A3A</color>
    <color name="rechazo">#9C4A46</color>
    <color name="aviso">#8A6D2F</color>

    <style name="Theme.PaltaScan" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E6EBE4</item>
        <item name="colorOnPrimaryContainer">@color/texto</item>
        <item name="colorSecondaryContainer">#E6EBE4</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/fondo</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOutline">@color/linea</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Etiqueta">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Valor">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Boton" parent="Widget.Material3.Button">
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="BotonBorde" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">6dp</item>
    </style>
</resources>
