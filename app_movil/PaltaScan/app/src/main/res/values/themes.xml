<resources>
    <!-- Paleta simple: verde, negro y blanco, esquinas rectas. -->
    <color name="primario">#2E7D32</color>
    <color name="primario_oscuro">#1B5E20</color>
    <color name="fondo">#FFFFFF</color>
    <color name="texto">#000000</color>
    <color name="texto_suave">#555555</color>
    <color name="linea">#BDBDBD</color>
    <color name="cat_i">#2E7D32</color>
    <color name="cat_ii">#B26A00</color>
    <color name="rechazo">#C62828</color>
    <color name="aviso">#B26A00</color>

    <style name="Theme.PaltaScan" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorPrimaryVariant">@color/primario_oscuro</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/primario</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/fondo</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="shapeAppearanceSmallComponent">@style/Recto</item>
        <item name="shapeAppearanceMediumComponent">@style/Recto</item>
        <item name="shapeAppearanceLargeComponent">@style/Recto</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Recto">
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Barra superior verde con titulo en blanco -->
    <style name="Barra">
        <item name="android:background">@color/primario</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="TituloBarra">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Etiqueta">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Valor">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Boton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <style name="BotonBorde" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">#212121</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <style name="BotonTexto" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/primario</item>
    </style>
</resources>
